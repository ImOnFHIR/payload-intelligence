{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imonfhir.com/schemas/imonfhir.host-hypothesis-receipt.v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "imonfhir.host-hypothesis-receipt.v1"
    },
    "caseHandle": {
      "type": "string",
      "pattern": "^ec_[a-f0-9]{32}$"
    },
    "caseDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "submissionId": {
      "type": "string",
      "pattern": "^hs_[a-f0-9]{32}$"
    },
    "submissionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hostKind": {
      "type": "string",
      "enum": [
        "CODEX",
        "CLAUDE_DESKTOP"
      ]
    },
    "state": {
      "type": "string",
      "const": "PENDING_SME_REVIEW"
    },
    "deduplicated": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "caseHandle",
    "caseDigest",
    "submissionId",
    "submissionDigest",
    "hostKind",
    "state",
    "deduplicated"
  ],
  "additionalProperties": false
}
