{
  "name": "imonfhir-payload-intelligence",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Experimental local workbench for bounded healthcare-payload evaluation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "tsc -b && npm run build --workspace @imonfhir/payload-lab",
    "check": "npm run typecheck && npm test && npm run build && npm run spdx:check && npm run license:check && npm run inventory:check && npm audit --audit-level=high",
    "demo:record": "npm run build && tsx scripts/record-demo.ts",
    "dev": "tsx scripts/lab.ts",
    "lab": "tsx scripts/lab.ts --open",
    "mcp:config": "tsx scripts/print-mcp-config.ts",
    "mcp:config:check": "tsx scripts/check-mcp-config.ts",
    "mcp:self-test": "tsx scripts/mcp-self-test.ts",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "schemas:generate": "npm run build --workspace @imonfhir/payload-core && npm run build --workspace @imonfhir/payload-contracts && tsx scripts/generate-schemas.ts",
    "secrets:check": "bash scripts/run-gitleaks.sh",
    "license:check": "node scripts/check-licenses.mjs",
    "test": "tsc -b && vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "spdx:check": "node scripts/check-spdx.mjs",
    "inventory:check": "node scripts/check-inventory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.15.30",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
